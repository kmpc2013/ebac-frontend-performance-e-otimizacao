{
  "name": "pet-style",
  "version": "1.0.0",
  "private": true,
  "description": "Pet&Style — landing page otimizada (atividade de Performance e Otimização para a Web, EBAC)",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "build:html": "node scripts/build-html.mjs",
    "build": "npm run build:css && npm run build:html",
    "images": "node scripts/images.mjs",
    "start": "serve ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "html-minifier-terser": "^7.2.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
